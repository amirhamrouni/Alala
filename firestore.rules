rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- User Profile Rules ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'displayName', 'groep', 'coins']) &&
             data.keys().size() >= 4 &&
             data.uid is string && data.uid.size() <= 128 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.groep is int && data.groep >= 1 && data.groep <= 8 &&
             data.coins is int && data.coins >= 0;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming()) && incoming().uid == userId;
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        // Prevent changing UID
        incoming().uid == existing().uid &&
        // Allow updates to coins, groep, displayName, etc.
        incoming().diff(existing()).affectedKeys().hasAny(['coins', 'groep', 'displayName', 'badges', 'lastActive', 'avatarId'])
      );
    }

    // --- Story Rules ---
    function isValidStory(data) {
      return data.keys().hasAll(['userId', 'title', 'content', 'createdAt']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.content is string && data.content.size() <= 10000 &&
             data.createdAt is timestamp;
    }

    match /stories/{storyId} {
      allow get: if isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isOwner(incoming().userId) && isValidStory(incoming()) && incoming().createdAt == request.time;
      allow delete: if isOwner(existing().userId);
      // Stories are immutable for now
      allow update: if false;
    }
  }
}
